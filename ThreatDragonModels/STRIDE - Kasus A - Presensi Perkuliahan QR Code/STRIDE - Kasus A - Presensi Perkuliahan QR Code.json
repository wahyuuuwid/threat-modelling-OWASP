              "privilegeLevel": "",
              "threats": [
                {
                  "id": "2c95483e-f7a2-4753-8405-ac659ffa9422",
                  "title": "Penyalahgunaan Kredensial Akun Mahasiswa untuk Titip Absen",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "Jika seorang mahasiswa membagikan username dan password atau kredensial akun kampus kepada temannya yang hadir di kelas, kemudian temannya menggunakan akun tersebut untuk login dan melakukan pemindaian QR Code, maka sistem dapat menganggap bahwa presensi dilakukan oleh pemilik akun yang sebenarnya. Hal ini dapat menyebabkan mahasiswa yang tidak hadir tercatat sebagai mahasiswa yang hadir dalam perkuliahan.\n\nLikelihood: 2 (Sedang).\n\nImpact: 3 (Tinggi).\n\nRisk Score: 2 × 3 = 6 (Tinggi).",
                  "mitigation": "Menerapkan autentikasi multifaktor, pendeteksian login mencurigakan, notifikasi login dari perangkat baru, kebijakan larangan berbagi kredensial, serta verifikasi kehadiran tambahan oleh dosen apabila ditemukan aktivitas mencurigakan.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": "6"
                },
                {
                  "id": "60352169-ad97-4ecf-afb7-d3b882e648cb",
                  "title": "Catatan presensi kurang lengkap sehingga mahasiswa atau dosen bisa mengelak",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "Jika sistem presensi hanya mencatat status hadir tanpa menyimpan jam pasti, identitas akun/sesi, dan asal koneksi (seperti IP atau perangkat) saat presensi diproses, maka mahasiswa bisa membantah saat dibilang bolos atau dosen bisa membantah saat dibilang membuka/menutup sesi, sehingga sulit dipastikan siapa yang sebenarnya melakukan tindakan tersebut. Dampak: Bukti aktivitas di sistem kurang jelas, jadi susah menelusuri kejadian atau menyelesaikan protes/sengketa presensi. Asumsi: Detail pencatatan log aktivitas belum dijelaskan secara rinci di deskripsi kasus.",
                  "mitigation": "Catat riwayat aktivitas penting di backend (audit logging), seperti siapa yang melakukan aksi (NIM/NIP), ID sesi, jam kejadian yang jelas, status aksi, dan info asal koneksi/perangkat (seperti IP), lalu jaga agar catatan riwayat ini tidak mudah diubah atau dihapus.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 7,
                  "score": "4"
                }
              ],
              "threatFrequency": {
